# Example environment settings for email delivery
# Choose one method and fill in the required credentials.

# Option 1: Gmail SMTP (simple, no custom sending domain required)
GMAIL_USER=yourgmail@gmail.com
GMAIL_PASS=your_gmail_app_password
GMAIL_FROM=Watamu Wilderness Safaris <yourgmail@gmail.com>
EMAIL_TO=wesongapeter68@yahoo.com

# Option 2: iCloud SMTP (simple, no custom sending domain required)
# Uncomment and use this instead of Gmail if you prefer iCloud.
# SMTP_HOST=smtp.mail.me.com
# SMTP_PORT=587
# SMTP_USER=youricloud@icloud.com
# SMTP_PASS=your_app_specific_password
# SMTP_SECURE=true
# EMAIL_FROM=Watamu Wilderness Safaris <youricloud@icloud.com>
# EMAIL_TO=wesongapeter68@yahoo.com

# Option 3: Generic SMTP provider (any email hosting provider)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# SMTP_SECURE=false
# EMAIL_FROM=Watamu Wilderness Safaris <no-reply@yourdomain.com>
# EMAIL_TO=wesongapeter68@yahoo.com

# Option 4: Resend (requires verified sending domain for general recipient delivery)
# RESEND_API_KEY=
# RESEND_FROM=Watamu Wilderness Safaris <onboarding@yourdomain.com>
# RESEND_TO=wesongapeter68@yahoo.com


